<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/shiro_black_bg"
    tools:context=".ui.RegistroActividadActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvTituloActividad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Registrar Actividad"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/shiro_white"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="16dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEmpleado"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Empleado (Mecánico)"
            app:hintTextColor="@color/shiro_text_gray"
            app:boxStrokeColor="@color/shiro_orange_primary"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:layout_constraintTop_toBottomOf="@id/tvTituloActividad"
            android:layout_marginTop="24dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEmpleado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:textColor="@color/shiro_white"
                android:inputType="text"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilTipoActividad"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tipo de Actividad"
            app:hintTextColor="@color/shiro_text_gray"
            app:boxStrokeColor="@color/shiro_orange_primary"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:layout_constraintTop_toBottomOf="@id/tilEmpleado"
            android:layout_marginTop="16dp">

            <AutoCompleteTextView
                android:id="@+id/actTipoActividad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/shiro_white"
                android:inputType="none"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPlacaMoto"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Placa de la Moto"
            app:hintTextColor="@color/shiro_text_gray"
            app:boxStrokeColor="@color/shiro_orange_primary"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:layout_constraintTop_toBottomOf="@id/tilTipoActividad"
            android:layout_marginTop="16dp">

            <AutoCompleteTextView
                android:id="@+id/actPlacaMoto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/shiro_white"
                android:inputType="none"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilRepuestoUsado"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Repuesto Usado"
            app:hintTextColor="@color/shiro_text_gray"
            app:boxStrokeColor="@color/shiro_orange_primary"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:layout_constraintTop_toBottomOf="@id/tilPlacaMoto"
            android:layout_marginTop="16dp">

            <AutoCompleteTextView
                android:id="@+id/actRepuestoUsado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/shiro_white"
                android:inputType="none"/>
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/btnGuardarActividad"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="GUARDAR ACTIVIDAD"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="@color/shiro_orange_primary"
            android:textColor="@color/shiro_white"
            app:cornerRadius="12dp"
            app:layout_constraintTop_toBottomOf="@id/tilRepuestoUsado"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>