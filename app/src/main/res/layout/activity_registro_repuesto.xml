<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/shiro_black_bg"
    tools:context=".ui.RegistroRepuestoActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvTituloRegistro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Registrar Nuevo Repuesto"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/shiro_white"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="16dp"/>

        <!-- CÓDIGO QR -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilCodigoQR"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Código (QR, Barras o Manual)"
            app:hintTextColor="@color/shiro_text_gray"
            app:boxStrokeColor="@color/shiro_orange_primary"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:layout_constraintTop_toBottomOf="@id/tvTituloRegistro"
            android:layout_marginTop="24dp"
            app:endIconMode="custom"
            app:endIconDrawable="@android:drawable/ic_menu_camera"
            app:endIconContentDescription="Escanear"
            app:endIconTint="@color/shiro_orange_primary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCodigoQR"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:textColor="@color/shiro_white"
                android:hint="Ej: REP-001"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- NOMBRE -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilNombre"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre del Repuesto"
            app:hintTextColor="@color/shiro_text_gray"
            app:boxStrokeColor="@color/shiro_orange_primary"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:layout_constraintTop_toBottomOf="@id/tilCodigoQR"
            android:layout_marginTop="16dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:textColor="@color/shiro_white"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- CATEGORÍA -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilCategoria"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Categoría (Motor, Frenos, etc.)"
            app:hintTextColor="@color/shiro_text_gray"
            app:boxStrokeColor="@color/shiro_orange_primary"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:layout_constraintTop_toBottomOf="@id/tilNombre"
            android:layout_marginTop="16dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCategoria"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:textColor="@color/shiro_white"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- STOCK ACTUAL -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilStockActual"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Stock Actual"
            app:hintTextColor="@color/shiro_text_gray"
            app:boxStrokeColor="@color/shiro_orange_primary"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:layout_constraintTop_toBottomOf="@id/tilCategoria"
            android:layout_marginTop="16dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etStockActual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:textColor="@color/shiro_white"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- STOCK MÍNIMO -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilStockMinimo"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Stock Mínimo (Alerta)"
            app:hintTextColor="@color/shiro_text_gray"
            app:boxStrokeColor="@color/shiro_orange_primary"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:layout_constraintTop_toBottomOf="@id/tilStockActual"
            android:layout_marginTop="16dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etStockMinimo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:textColor="@color/shiro_white"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- PRECIO -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPrecio"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Precio Unitario (S/)"
            app:hintTextColor="@color/shiro_text_gray"
            app:boxStrokeColor="@color/shiro_orange_primary"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:layout_constraintTop_toBottomOf="@id/tilStockMinimo"
            android:layout_marginTop="16dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPrecio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:textColor="@color/shiro_white"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- BOTÓN GUARDAR -->
        <Button
            android:id="@+id/btnGuardarRepuesto"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="GUARDAR REPUESTO"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="@color/shiro_orange_primary"
            android:textColor="@color/shiro_white"
            app:cornerRadius="12dp"
            app:layout_constraintTop_toBottomOf="@id/tilPrecio"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>