<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp"
    android:layout_marginBottom="8dp"
    android:background="@color/shiro_black_surface"
    app:cardCornerRadius="12dp">

    <TextView
        android:id="@+id/tvItemNombre"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Nombre del Repuesto"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/shiro_white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tvItemCodigo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Código: REP-001"
        android:textSize="13sp"
        android:textColor="@color/shiro_text_gray"
        app:layout_constraintTop_toBottomOf="@id/tvItemNombre"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="4dp"/>

    <TextView
        android:id="@+id/tvItemCategoria"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Categoría: Motor"
        android:textSize="13sp"
        android:textColor="@color/shiro_text_gray"
        app:layout_constraintTop_toBottomOf="@id/tvItemCodigo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="4dp"/>

    <TextView
        android:id="@+id/tvItemStock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Stock: 10"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/shiro_white"
        app:layout_constraintTop_toBottomOf="@id/tvItemCategoria"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="8dp"/>

    <TextView
        android:id="@+id/tvItemPrecio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="S/ 25.00"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/shiro_orange_primary"
        app:layout_constraintTop_toBottomOf="@id/tvItemCategoria"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"/>

    <TextView
        android:id="@+id/tvAlertaStock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⚠ STOCK BAJO - REALIZAR PEDIDO"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/shiro_white"
        android:background="@color/shiro_red_alert"
        android:padding="6dp"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tvItemStock"
        android:layout_marginTop="8dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>