<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp"
    android:layout_marginBottom="8dp"
    android:background="@color/shiro_black_surface">

    <TextView
        android:id="@+id/tvItemTipoResiduo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Aceite Usado"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/shiro_white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tvItemCantidadResiduo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Cantidad: 5 Litros"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/shiro_orange_primary"
        app:layout_constraintTop_toBottomOf="@id/tvItemTipoResiduo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="4dp"/>

    <TextView
        android:id="@+id/tvItemFechaResiduo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Fecha: 21/09/2026"
        android:textSize="12sp"
        android:textColor="@color/shiro_text_gray"
        app:layout_constraintTop_toBottomOf="@id/tvItemCantidadResiduo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="2dp"/>

    <TextView
        android:id="@+id/tvItemObsResiduo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Obs: Sin observaciones"
        android:textSize="12sp"
        android:textColor="@color/shiro_text_gray"
        app:layout_constraintTop_toBottomOf="@id/tvItemFechaResiduo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="2dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>